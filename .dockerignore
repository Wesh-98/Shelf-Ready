# Keep the build context to what the image actually runs. The desktop app,
# its build artifacts and the venv are all far larger than the web front end
# and none of them belong in the container.
.git/
.github/
.venv/
__pycache__/
**/__pycache__/
*.pyc
build/
dist/
samples/
tests/
assets/design/
ShelfReady.spec
ShelfReady_Unified_GUI.py
*.bat

# Documentation, read on GitHub rather than by the running app. The
# Dockerfile's COPY lines already leave these out; listing them keeps
# them out of the context uploaded to the remote builder too.
docs/
README.md
LICENSE

Dockerfile
.dockerignore
